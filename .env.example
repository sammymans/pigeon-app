# Server-only Convex settings. Copy to an ignored local file if needed;
# set these on the selected Convex deployment, not in Expo public variables.
# See docs/whop-store.md. Empty values keep checkout disabled.
WHOP_ENVIRONMENT=sandbox
PIGEON_PUBLIC_ORIGIN=
WHOP_SANDBOX_API_KEY=
WHOP_SANDBOX_WEBHOOK_SECRET=
WHOP_SANDBOX_ACCOUNT_ID=
WHOP_SANDBOX_POINTS_100_VARIANT_ID=
WHOP_SANDBOX_POINTS_550_VARIANT_ID=
WHOP_SANDBOX_POINTS_1200_VARIANT_ID=

# Additional pigeon: $5.00 USD, as agreed. Its Whop variant must match.
PIGEON_PRICE_CENTS=500
WHOP_SANDBOX_PIGEON_VARIANT_ID=
# Retained legacy Aviator product, not required for point purchases.
WHOP_SANDBOX_VARIANT_ID=

# Production credentials belong on a separate production Convex deployment.
# Enable it explicitly with WHOP_ENVIRONMENT=production only after sandbox verification.
WHOP_LIVE_API_KEY=
WHOP_LIVE_WEBHOOK_SECRET=
WHOP_LIVE_ACCOUNT_ID=
WHOP_LIVE_POINTS_100_VARIANT_ID=
WHOP_LIVE_POINTS_550_VARIANT_ID=
WHOP_LIVE_POINTS_1200_VARIANT_ID=
WHOP_LIVE_PIGEON_VARIANT_ID=
WHOP_LIVE_VARIANT_ID=
